<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:granite="http://www.adobe.com/jcr/granite/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Properties"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
        <items jcr:primaryType="nt:unstructured">
            <column
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Rest Api"
                        name="./text"/>
                    <widgetList
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/multifield"
                        composite="{Boolean}true"
                        eaem-min-items="1"
                        fieldLabel="Floating Widget Multi-List (Min: 1, Max: N/A)">
                        <field
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/container"
                            name="./widgetList">
                            <items jcr:primaryType="nt:unstructured">
                                <buttonLabel
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldDescription="The text to be displayed on the left of the floating button."
                                    fieldLabel="Button Label"
                                    name="./buttonLabel"
                                    required="{Boolean}true"/>
                                <tileImage
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                                    fieldDescription="The Image for each tile"
                                    fieldLabel="Tile Image"
                                    name="./tileImage"
                                    required="{Boolean}true"
                                    rootPath="/content/dam"/>
                                <tileImageAltText
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldDescription="The alt text of the tile image"
                                    fieldLabel="Tile Image Alt Text"
                                    name="./tileImageAltText"/>
                                <tileTitle
                                    jcr:primaryType="nt:unstructured"
                                    sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                                    fieldDescription="This will be the title of the tile"
                                    fieldLabel="Tile Title"
                                    name="./tileTitle"
                                    required="{Boolean}true"/>
                            </items>
                        </field>
                    </widgetList>
                    <tileType
                        granite:class="cq-dialog-dropdown-showhide"
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/select"
                        fieldLabel="Tile Icon Type"
                        name="./tileIconType">
                        <granite:data
                            jcr:primaryType="nt:unstructured"
                            cq-dialog-dropdown-showhide-target=".tileIconType-showhide-target"/>
                        <items jcr:primaryType="nt:unstructured">
                            <none
                                jcr:primaryType="nt:unstructured"
                                selected="{Boolean}true"
                                text="None"
                                value="none"/>
                            <iconFontAwsomeId
                                jcr:primaryType="nt:unstructured"
                                text="Icon Font Awesome ID"
                                value="iconFontAwsomeId"/>
                        </items>
                    </tileType>
                    <tileIconType
                            granite:class="cq-dialog-dropdown-showhide"
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="granite/ui/components/coral/foundation/form/select"
                            fieldDescription="This determines the icon type of the tile"
                            fieldLabel="Tile Icon Type" name="./tileIconType"
                            required="{Boolean}true">
                        <granite:data
                                jcr:primaryType="nt:unstructured"
                                cq-dialog-dropdown-showhide-target=".tileIconType-showhide-target" />
                        <items jcr:primaryType="nt:unstructured">
                            <none jcr:primaryType="nt:unstructured"
                                  text="None" selected="{Boolean}true" value="none" />
                            <iconFontAwsomeId jcr:primaryType="nt:unstructured"
                                              text="Icon Font Awesome ID" value="iconFontAwsomeId" />
                            <iconImage jcr:primaryType="nt:unstructured"
                                       text="Icon Image" value="iconImage" />
                        </items>
                    </tileIconType>
                </items>
            </column>
        </items>
    </content>
</jcr:root>
